# Neon PostgreSQL connection string. Persistence is not wired until a database repository is enabled.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
# Comma-separated browser origins, for example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional future AI provider key
OPENAI_API_KEY=
