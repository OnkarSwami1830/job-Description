# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=talentlens
# Use a long random value in production.
TOKEN_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins, for example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional future AI provider key
OPENAI_API_KEY=
GEMINI_API_KEY=
